Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"earth", "=", 
   TemplateBox[{"\"Earth\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Planet\"", ",", "\"Earth\""}], "]"}], 
     "\"Entity[\\\"Planet\\\", \\\"Earth\\\"]\"", "\"planet\""},
    "Entity"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sun", "=", 
   TemplateBox[{"\"Sun\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Star\"", ",", "\"Sun\""}], "]"}], 
     "\"Entity[\\\"Star\\\", \\\"Sun\\\"]\"", "\"star\""},
    "Entity"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"moon", "=", 
   TemplateBox[{"\"Moon\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"PlanetaryMoon\"", ",", "\"Moon\""}], "]"}], 
     "\"Entity[\\\"PlanetaryMoon\\\", \\\"Moon\\\"]\"", "\"planetary moon\""},
    
    "Entity"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.95444913415425*^9, 3.954449148984223*^9}, {
  3.954757734418964*^9, 3.95475774190025*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5135f93c-99b0-4a26-9fc9-67d52bc03684"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"positionICRS", "[", 
    RowBox[{"body_", ",", "date_"}], "]"}], ":=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"Quantity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AstroPosition", "[", 
         RowBox[{"body", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<ICRS\>\"", ",", 
            RowBox[{"\"\<Date\>\"", "->", "date"}]}], "}"}], 
          ",", "\"\<Cartesian\>\""}], "]"}], "[", "\"\<Data\>\"", "]"}], 
       ",", "\"\<AstronomicalUnit\>\""}], "]"}], ",", "\"\<Meters\>\""}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9544479427940598`*^9, 3.954447944202832*^9}, {
  3.9544480458392153`*^9, 3.954448051080587*^9}, {3.9544481604465637`*^9, 
  3.9544481816677647`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"5cad8b1c-9442-43df-a168-b428932d5e22"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dates", "=", 
    RowBox[{"DateRange", "[", 
     RowBox[{
      TemplateBox[<|
       "query" -> "Jan 1, 2000 0:00:00 UTC", "boxes" -> TemplateBox[{
           RowBox[{"\"Sat 1 Jan 2000 00:00:00\"", 
             StyleBox["\"UTC\"", "TimeZoneLabel"]}], 
           RowBox[{"DateObject", "[", 
             RowBox[{
               RowBox[{"{", 
                 
                 RowBox[{
                  "2000", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
                 "}"}], ",", "\"Instant\"", ",", "\"Gregorian\"", ",", 
               "\"UTC\""}], "]"}]}, "DateObject", Editable -> False], 
        "allassumptions" -> {{
          "type" -> "TimeAMOrPM", "word" -> "12:00:00", "template" -> 
           "Assuming 12:00:00 AM${separator}Use ${desc} instead", "count" -> 
           "2", "pulldown" -> "false", "default" -> 
           "{\"TimeAMOrPM\", {2000, 1, 1, 0, 0, 0}} -> \"am\"", 
           "Values" -> {{
             "name" -> "am", "desc" -> "12:00:00 AM", "input" -> 
              "{\"TimeAMOrPM\", {2000, 1, 1, 0, 0, 0}} -> \"am\""}, {
             "name" -> "pm", "desc" -> "PM", "input" -> 
              "{\"TimeAMOrPM\", {2000, 1, 1, 0, 0, 0}} -> \"pm\""}}}}, 
        "assumptions" -> {}, "open" -> {1, 2}, 
        "querystate" -> {
         "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
          0.801543`6.355471819202729, "Messages" -> {}}, "contextinfo" -> 
        Automatic, "version" -> 5|>,
       "LinguisticAssistantTemplate"], ",", 
      RowBox[{"DatePlus", "[", 
       RowBox[{
        TemplateBox[{
          RowBox[{"\"Sat 1 Jan 2000 00:00:00\"", 
            StyleBox["\"UTC\"", "TimeZoneLabel"]}], 
          RowBox[{"DateObject", "[", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "2000", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
                "}"}], ",", "\"Instant\"", ",", "\"Gregorian\"", ",", 
              "\"UTC\""}], "]"}]},
         "DateObject",
         Editable->False], ",", 
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          TemplateBox[{"5", "\"yr\"", "years", "\"Years\""},
           "Quantity"], ",", "\"\<Seconds\>\""}], "]"}]}], "]"}], ",", 
      RowBox[{"Quantity", "[", 
       RowBox[{"0.1382", ",", " ", "\"\<Days\>\""}], "]"}]}], "]"}]}], ";"}], 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dates", " ", "from", " ", "Jan", " ", "1"}], ",", " ", 
    RowBox[{"2000", " ", "to", " ", "Dec", " ", "29"}], ",", " ", 
    RowBox[{"2009", " ", "day", " ", "by", " ", "day"}]}], "*)"}]}]], "Input",\

 CellChangeTimes->{{3.954448201272273*^9, 3.9544482024479628`*^9}, {
   3.954449052486738*^9, 3.9544490895621967`*^9}, {3.954449252108103*^9, 
   3.95444934968801*^9}, {3.954497908291092*^9, 3.954497911957745*^9}, {
   3.9544979421370783`*^9, 3.954497965725951*^9}, {3.954497998761015*^9, 
   3.954498026157351*^9}, 3.954765059384433*^9, {3.9547651032021*^9, 
   3.954765106243576*^9}, {3.954765137174646*^9, 3.954765139480163*^9}, {
   3.955366351670205*^9, 3.955366383862316*^9}, 3.95536643978032*^9, {
   3.955366542425606*^9, 3.9553665426288147`*^9}, {3.955366704180236*^9, 
   3.955366712952725*^9}, {3.955366753777916*^9, 3.955366772611807*^9}, {
   3.956699750143251*^9, 3.956699755182735*^9}, {3.956775578536695*^9, 
   3.956775580472178*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e063c6af-72e0-4d71-88c3-96c05a3823e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"earthposdata", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"positionICRS", "[", 
      RowBox[{"earth", ",", "i"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "dates"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sunposdata", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"positionICRS", "[", 
      RowBox[{"sun", ",", "i"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "dates"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"moonposdata", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"positionICRS", "[", 
      RowBox[{"moon", ",", "i"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "dates"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.954449103472165*^9, 3.954449212985106*^9}, {
  3.954757857918611*^9, 3.954757858207487*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"3df2feb8-34e6-429f-8a47-bed88855e439"],

Cell[BoxData[
 RowBox[{
  RowBox[{"posdata", "=", 
   RowBox[{"Dataset", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Time\>\"", "->", 
         RowBox[{"DateString", "[", "i", "]"}]}], ",", 
        RowBox[{"\"\<Earth Position\>\"", "->", 
         RowBox[{"QuantityMagnitude", "/@", 
          RowBox[{"positionICRS", "[", 
           RowBox[{"earth", ",", "i"}], "]"}]}]}], ",", 
        RowBox[{"\"\<Sun Position\>\"", "->", 
         RowBox[{"QuantityMagnitude", "/@", 
          RowBox[{"positionICRS", "[", 
           RowBox[{"sun", ",", "i"}], "]"}]}]}], ",", 
        RowBox[{"\"\<Moon Position\>\"", " ", "->", " ", 
         RowBox[{"QuantityMagnitude", "/@", 
          RowBox[{"positionICRS", "[", 
           RowBox[{"moon", ",", "i"}], "]"}]}]}]}], "|>"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "\[IndentingNewLine]", "dates"}], "}"}]}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954449434612797*^9, 3.954449502493616*^9}, {
   3.954449533567169*^9, 3.954449583852206*^9}, {3.954449619028264*^9, 
